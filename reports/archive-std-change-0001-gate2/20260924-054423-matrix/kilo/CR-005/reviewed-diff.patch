diff --git a/src/csv_export.py b/src/csv_export.py
new file mode 100644
index 0000000..fd22bda
--- /dev/null
+++ b/src/csv_export.py
@@ -0,0 +1,8 @@
+"""CSV export for period reports."""
+
+
+def format_period(start: str, end: str) -> str:
+    """Render a reporting period label."""
+    if start > end:
+        start, end = end, start
+    return f"{start}..{end}"
